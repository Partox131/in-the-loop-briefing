    "maxrecords": 250,
    "disabledQueries": [
      {
        "id": "wires-middle-east",
        "query": "(iran OR israel OR gaza OR lebanon OR syria OR yemen OR ukraine OR russia OR nato OR taiwan OR china) (domainis:reuters.com OR domainis:apnews.com OR domainis:haaretz.com OR domainis:timesofisrael.com OR domainis:ynetnews.com OR domainis:presstv.ir)"
